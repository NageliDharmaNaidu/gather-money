PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Optional for local development (SQLite is used when blank).
# Required for production; use a persistent PostgreSQL connection string.
DATABASE_URL=

# Optional Google OAuth. Add the same callback URL to your Google OAuth client:
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:3000

# Optional SMS codes through Twilio. SMS is sent only after a person requests a code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

